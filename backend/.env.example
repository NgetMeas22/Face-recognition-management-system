# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development            # development | test | production
DEBUG=false

# MySQL (Laragon). The database and user are created by scripts/create_database.sql.
DATABASE_URL=mysql+pymysql://facetrack:CHANGE_ME@127.0.0.1:3306/facetrack?charset=utf8mb4
# Used only by pytest. The tests DROP and recreate this database — never point it at real data.
TEST_DATABASE_URL=mysql+pymysql://facetrack:CHANGE_ME@127.0.0.1:3306/facetrack_test?charset=utf8mb4
DB_ECHO=false

# Tokens
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # must be true in production (HTTPS)

# Login protection
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_IP_RATE_LIMIT_PER_MINUTE=30

# Comma-separated frontend origins. The Next.js app proxies /api/v1 (same origin), so CORS only
# matters if a browser calls this API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TIMEZONE=Asia/Phnom_Penh
