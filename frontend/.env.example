# Copy to .env.local. This file must never contain secrets.
#
# Server-only URL of the FastAPI backend. The browser never calls it directly: Next.js
# proxies /api/v1/* to it, so auth cookies stay first-party and no CORS is needed.
# It is read at build time (rewrites), so rebuild after changing it.
BACKEND_URL=http://127.0.0.1:8000

# Only used by `npm run test:e2e` (Playwright). Use a dedicated test admin account.
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_VIEWER_USERNAME=
E2E_VIEWER_PASSWORD=
