# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development            # development | test | production
DEBUG=false

# PostgreSQL (psycopg 3). Create the role and databases with scripts/create_database.sql
# (or pgAdmin 4; see README). The app connects as this role, never as the postgres superuser.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=facetrack
POSTGRES_USER=facetrack
POSTGRES_PASSWORD=CHANGE_ME
# Used only by pytest. Its `public` schema is DROPPED and rebuilt on every run, so never point it
# at real data. Must contain "test" in its name.
POSTGRES_TEST_DB=facetrack_test
# Optional: a full URL overrides the POSTGRES_* parts above (driver must be postgresql+psycopg).
# Percent-encode special characters in the password if you use this form.
# DATABASE_URL=postgresql+psycopg://facetrack:CHANGE_ME@localhost:5432/facetrack
# TEST_DATABASE_URL=postgresql+psycopg://facetrack:CHANGE_ME@localhost:5432/facetrack_test
DB_ECHO=false

# Tokens
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # must be true in production (HTTPS)

# Login protection
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_IP_RATE_LIMIT_PER_MINUTE=30

# Comma-separated frontend origins. The Next.js app proxies /api/v1 (same origin), so CORS only
# matters if a browser calls this API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TIMEZONE=Asia/Phnom_Penh
